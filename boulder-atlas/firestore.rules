rules_version = '2';
// users/{uid} = { saved: {problemId: savedAtMillis}, lists: {listId: {name, items: {problemId: addedAt}, updated}}, updatedAt }
// Each signed-in person can read and write only their own document. Shared lists travel inside the
// share link itself, so nothing here is public.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['saved', 'lists', 'updatedAt'])
        && (!('saved' in request.resource.data) || (request.resource.data.saved is map && request.resource.data.saved.size() <= 5000))
        && (!('lists' in request.resource.data) || (request.resource.data.lists is map && request.resource.data.lists.size() <= 200));
    }
  }
}
