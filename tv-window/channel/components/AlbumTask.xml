<?xml version="1.0" encoding="utf-8"?>
<!-- Reads a public Google Photos shared-album link and returns its photos as [{url, w, h}]. -->
<component name="AlbumTask" extends="Task">
  <interface>
    <field id="url" type="string" />
    <field id="result" type="assocarray" />
  </interface>
  <script type="text/brightscript" uri="AlbumTask.brs" />
</component>
